<!-- Append to /var/ossec/etc/ossec.conf on the Wazuh manager, then:
     sudo systemctl restart wazuh-manager
     Blocks the source IP of an SSH brute force (rule 5763) on the agent
     that raised the alert, for 180 seconds. -->
<ossec_config>
  <active-response>
    <command>firewall-drop</command>
    <location>local</location>
    <rules_id>5763</rules_id>
    <timeout>180</timeout>
  </active-response>
</ossec_config>
